{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/create-weekly-services", "schedule": "0 11 * * *" },
    { "path": "/api/cron/open-job-pool", "schedule": "0 12 * * *" },
    { "path": "/api/cron/process-employee-payouts", "schedule": "0 16 * * 5" }
  ]
}
